{
  "name": "hello-big2",
  "description": "Big text within 255px printer limit",
  "dimensions": { "width": 255, "height": 192 },
  "defaultFont": { "family": "Norwester Condensed", "size": 30 },
  "elements": [
    {
      "type": "text",
      "content": "{{line1}}",
      "fontSize": 52,
      "position": { "x": 8, "y": 45 },
      "align": "left"
    },
    {
      "type": "text",
      "content": "{{line2}}",
      "fontSize": 30,
      "position": { "x": 8, "y": 82 },
      "align": "left"
    }
  ]
}
